@model BookingSystem.Models.Medicine

@{
    ViewData["Title"] = "Delete Medicine";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card mt-4">
                <div class="card-header">
                    <h2 class="text-center mb-0">Delete Medicine</h2>
                </div>
                <div class="card-body">
                    <div class="alert alert-danger">
                        <h4>Are you sure you want to delete this medicine?</h4>
                        <p>This action cannot be undone.</p>
                    </div>

                    <dl class="row">
                        <dt class="col-sm-4">Medicine Name</dt>
                        <dd class="col-sm-8">@Model.MedicineName</dd>

                        <dt class="col-sm-4">Stock Quantity</dt>
                        <dd class="col-sm-8">@Model.Stock</dd>

                        <dt class="col-sm-4">Dosage (mg)</dt>
                        <dd class="col-sm-8">@Model.Dosage mg</dd>
                    </dl>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="MedicineId" />
                        <div class="d-flex gap-3 justify-content-center mt-4">
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash"></i> Confirm Delete
                            </button>
                            <a asp-action="Index" class="btn btn-outline-custom">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background: linear-gradient(rgba(95, 158, 160, 0.95), rgba(95, 158, 160, 0.95)), url('https://www.transparenttextures.com/patterns/cubes.png') no-repeat center center fixed;
        background-size: cover;
        min-height: 100vh;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
    .card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 20px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
    }
    .card-header {
        background: rgba(95, 158, 160, 0.9);
        border-bottom: 1px solid rgba(255, 255, 255, 0.2);
        padding: 20px;
        border-radius: 20px 20px 0 0 !important;
        color: white;
    }
    .btn-outline-custom {
        background: transparent;
        color: cadetblue;
        border: 2px solid cadetblue;
        padding: 10px 30px;
        border-radius: 50px;
        font-weight: 600;
        transition: all 0.3s ease;
    }
        .btn-outline-custom:hover {
            background: cadetblue;
            color: white;
        }
    .alert-danger {
        background: rgba(220, 53, 69, 0.1);
        border: 1px solid rgba(220, 53, 69, 0.3);
        border-radius: 10px;
    }
</style> 