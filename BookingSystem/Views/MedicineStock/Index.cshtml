@model IEnumerable<BookingSystem.Models.Medicine>

@{
    ViewData["Title"] = "Medicine Stock Management";
}

<div class="container">
    <div class="card mt-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h2 class="mb-0">Medicine Stock Management</h2>
            <a asp-action="Create" class="btn btn-primary-custom">
                <i class="bi bi-plus-circle"></i> Add New Medicine
            </a>
        </div>
        <div class="card-body">
            
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Medicine ID</th>
                            <th>Medicine Name</th>
                            <th>Stock Quantity</th>
                            <th>Dosage (mg)</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var medicine in Model)
                            {
                                <tr>
                                    <td>@medicine.MedicineId</td>
                                    <td>@medicine.MedicineName</td>
                                    <td>
                                        @medicine.Stock
                                        @if (medicine.Stock <= 10 && medicine.Stock > 0)
                                        {
                                            <span class="badge bg-warning text-dark ms-2">Low Stock!</span>
                                        }
                                        else if (medicine.Stock == 0)
                                        {
                                            <span class="badge bg-danger ms-2">Out of Stock!</span>
                                        }
                                    </td>
                                    <td>@medicine.Dosage mg</td>
                                    <td>
                                        @if (medicine.Stock > 10)
                                        {
                                            <span class="badge bg-success">In Stock</span>
                                        }
                                        else if (medicine.Stock > 0)
                                        {
                                            <span class="badge bg-warning text-dark">Limited</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Unavailable</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-action="Edit" asp-route-id="@medicine.MedicineId" class="btn btn-sm btn-primary-custom">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@medicine.MedicineId" class="btn btn-sm btn-danger">
                                            <i class="bi bi-trash"></i> Delete
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center">
                                    <div class="alert alert-info mb-0">
                                        No medicines found. Click "Add New Medicine" to get started.
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background: linear-gradient(rgba(95, 158, 160, 0.95), rgba(95, 158, 160, 0.95)), url('https://www.transparenttextures.com/patterns/cubes.png') no-repeat center center fixed;
        background-size: cover;
        min-height: 100vh;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 20px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
        margin-bottom: 30px;
    }

    .card-header {
        background: rgba(95, 158, 160, 0.9);
        border-bottom: 1px solid rgba(255, 255, 255, 0.2);
        padding: 20px;
        border-radius: 20px 20px 0 0 !important;
        color: white;
    }

        .card-header h2 {
            margin: 0;
            font-weight: 600;
        }

    .btn-primary-custom {
        background: white;
        color: cadetblue;
        border: 2px solid cadetblue;
        padding: 8px 20px;
        border-radius: 50px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-primary-custom:hover {
            background: cadetblue;
            color: white;
            transform: scale(1.02);
        }

    .table {
        margin-bottom: 0;
    }

        .table thead th {
            background: rgba(95, 158, 160, 0.2);
            color: #2c3e50;
            font-weight: 600;
            border-bottom: 2px solid cadetblue;
        }

        .table tbody tr:hover {
            background: rgba(95, 158, 160, 0.1);
        }

    .alert-success {
        background: rgba(40, 167, 69, 0.2);
        border: 1px solid rgba(40, 167, 69, 0.5);
        color: #155724;
        border-radius: 10px;
    }
</style>
