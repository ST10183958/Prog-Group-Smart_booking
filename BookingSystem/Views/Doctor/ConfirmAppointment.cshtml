@model BookingSystem.Models.Appointment

@{
    ViewBag.Title = "Confirm Appointment";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Confirm Appointment</title>

    <style>
        body {
            background: linear-gradient(rgba(95, 158, 160, 0.95), rgba(95, 158, 160, 0.95)), url('https://www.transparenttextures.com/patterns/cubes.png');
            background-size: cover;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
        }

        .container {
            max-width: 700px;
            margin: 40px auto;
            background: rgba(255,255,255,0.35);
            padding: 30px;
            border-radius: 20px;
        }

        h2 {
            margin-top: 0;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            font-weight: bold;
            display: block;
            margin-bottom: 8px;
        }

        input, textarea, select {
            width: 100%;
            padding: 12px;
            border: none;
            border-radius: 10px;
            box-sizing: border-box;
        }

        .btn {
            padding: 12px 20px;
            border: none;
            cursor: pointer;
            font-weight: bold;
            margin-right: 10px;
        }

        .save-btn {
            background: #5aa3a3;
        }

        .back-btn {
            background: #d86a6a;
            text-decoration: none;
            display: inline-block;
            color: black;
        }

        .patient-box {
            background: rgba(255,255,255,0.25);
            padding: 15px;
            border-radius: 12px;
            margin-bottom: 25px;
        }

        .validation-summary-errors {
            color: darkred;
            margin-bottom: 15px;
        }
    </style>
</head>
<body>

    <div class="container">
        <h2>Confirm Appointment</h2>

        <div class="patient-box">
            <p><strong>Patient:</strong> @Model.Patient.PatientName @Model.Patient.PatientSurname</p>
            <p><strong>Illness:</strong> @Model.AppointmentIllness</p>
            <p><strong>Preferred Date:</strong> @Model.PreferredAppointmentDate.ToShortDateString()</p>
        </div>

        <form asp-action="ConfirmAppointment" asp-controller="Prescription" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="appointmentId" value="@Model.AppointmentId" />

            @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

            <div class="form-group">
                <label for="symptoms">Symptoms</label>
                <textarea name="symptoms" id="symptoms" rows="4" required></textarea>
            </div>

            <div class="form-group">
                <label for="description">Description / Notes</label>
                <textarea name="description" id="description" rows="5" required></textarea>
            </div>

            <div class="form-group">
                <label for="medicineId">Assign Medication</label>
                <select name="medicineId" id="medicineId" required>
                    <option value="">-- Select Medication --</option>
                    @foreach (var item in ViewBag.Medications as List<SelectListItem>)
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                </select>
            </div>

            <button type="submit" class="btn save-btn">SAVE CONFIRMATION</button>
            <a asp-action="AppointmentsPage" asp-controller="Doctor" class="btn back-btn">BACK</a>
        </form>
    </div>

</body>
</html>