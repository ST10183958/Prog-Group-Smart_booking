@model List<BookingSystem.Models.Appointment>

@{
    ViewBag.Title = "Patient List";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Patient List</title>

    <style>
        body {
            background: linear-gradient(rgba(95, 158, 160, 0.95), rgba(95, 158, 160, 0.95)), url('https://www.transparenttextures.com/patterns/cubes.png');
            background-size: cover;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
        }

        .header {
            background: rgba(0,0,0,0.2);
            display: flex;
            align-items: center;
            padding: 10px 20px;
            color: black;
        }

        .doctor-box {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .circle {
            width: 50px;
            height: 50px;
            background: #7aa5a5;
            border-radius: 50%;
        }

        .header-title {
            flex: 1;
            text-align: right;
            font-size: 28px;
            font-weight: bold;
        }

        .container {
            padding: 40px;
        }

        .card {
            margin-bottom: 30px;
        }

        .info-box {
            background: rgba(255,255,255,0.35);
            padding: 25px;
            border-radius: 15px;
            width: 500px;
        }

        .info-box p {
            margin: 10px 0;
            font-weight: 500;
        }

        .btn-group {
            margin-top: 20px;
        }

        .btn {
            padding: 12px 20px;
            border: none;
            cursor: pointer;
            font-weight: bold;
        }

        .confirm {
            background: #5aa3a3;
        }

        .decline {
            background: #d86a6a;
            margin-left: 10px;
        }

        .empty-message {
            background: rgba(255,255,255,0.35);
            padding: 20px;
            border-radius: 15px;
            font-weight: bold;
            width: fit-content;
        }
    </style>
</head>
<body>

    <div class="header">
        <div class="doctor-box">
            <div class="circle"></div>
            <div>
                <strong>@ViewBag.DoctorName @ViewBag.DoctorSurname</strong><br />
                Admin Number: @ViewBag.DoctorId
            </div>
        </div>

        <div class="header-title">
            PATIENT LIST
        </div>
    </div>

    <div class="container">
        @if (Model != null && Model.Any())
        {
            foreach (var appointment in Model)
            {
                <div class="card">
                    <div class="info-box">
                        <p><strong>Appointment ID:</strong> @appointment.AppointmentId</p>
                        <p><strong>Name:</strong> @appointment.Patient.PatientName</p>
                        <p><strong>Surname:</strong> @appointment.Patient.PatientSurname</p>
                        <p><strong>Passport Number:</strong> @appointment.Patient.PassportNumber</p>
                        <p><strong>DOB:</strong> @appointment.Patient.DateOfBirth.ToShortDateString()</p>
                        <p><strong>Email Address:</strong> @appointment.Patient.EmailAddress</p>
                        <p><strong>Mobile Number:</strong> @appointment.Patient.MobileNumber</p>
                        <p><strong>Province:</strong> @appointment.Province</p>
                        <p><strong>Surburb:</strong> @appointment.Surburb</p>
                        <p><strong>Session:</strong> @appointment.AppointmentSession</p>
                        <p><strong>Illness:</strong> @appointment.AppointmentIllness</p>
                        <p><strong>Preferred Date:</strong> @appointment.PreferredAppointmentDate.ToShortDateString()</p>
                    </div>

                    <div class="btn-group">
                        <form asp-action="ConfirmAppointment" asp-controller="Doctor" method="get" style="display:inline;">
                            <input type="hidden" name="appointmentId" value="@appointment.AppointmentId" />
                            <button type="submit" class="btn confirm">CONFIRM APPOINTMENT</button>
                        </form>

                        <form asp-action="DeclineAppointment" asp-controller="Doctor" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="appointmentId" value="@appointment.AppointmentId" />
                            <button type="submit" class="btn decline">DECLINE APPOINTMENT</button>
                        </form>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-message">
                No appointments booked for this doctor.
            </div>
        }
    </div>

</body>
</html>