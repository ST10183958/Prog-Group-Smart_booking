@model List<BookingSystem.Models.Doctor>

@{
    ViewData["Title"] = "Appointment Details";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Medical Care - Appointment Details</title>

    <style>
        body {
            background: linear-gradient(rgba(95, 158, 160, 0.95), rgba(95, 158, 160, 0.95)), url('https://www.transparenttextures.com/patterns/cubes.png') no-repeat center center fixed;
            background-size: cover;
            min-height: 100vh;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .page-wrap {
            width: 95%;
            margin: 0 auto;
            padding: 20px 0 40px;
        }

        h1 {
            text-align: center;
            font-family: Georgia, 'Times New Roman', Times, serif;
            font-size: 54px;
            margin: 20px 0 10px;
            color: #2a2a2a;
        }

        h2, h3 {
            text-align: center;
            margin: 8px 0;
            color: #1f2d2d;
        }

        .main-layout {
            width: 100%;
            margin-top: 25px;
        }

        .sidebar {
            width: 270px;
            vertical-align: top;
            padding-left: 30px;
        }

        .content-area {
            vertical-align: top;
            padding-right: 20px;
        }

        input[type="text"], input[type="date"], select, textarea {
            width: 95%;
            padding: 8px;
            border: 1px solid #c7dede;
            background: rgba(255,255,255,0.35);
            outline: none;
        }

        .doctor-box {
            background: rgba(255,255,255,0.35);
            padding: 18px;
            min-height: 160px;
            border: 1px solid #c5dddd;
        }

        .action-btn {
            padding: 10px 18px;
            border: 1px solid #8aa;
            background: #5f7f7b;
            color: #111;
            font-size: 16px;
        }

        .confirm-booking {
            width: 250px;
            padding: 14px;
            border: 1px solid #c7dede;
            background: rgba(255,255,255,0.45);
            font-size: 16px;
            cursor: pointer;
        }

        .alert-box {
            width: 80%;
            margin: 20px auto;
            padding: 12px;
            border-radius: 8px;
            text-align: center;
        }

        .alert-success {
            background: rgba(40, 167, 69, 0.2);
            border: 1px solid rgba(40, 167, 69, 0.6);
            color: #103d1f;
        }

        .alert-danger {
            background: rgba(220, 53, 69, 0.2);
            border: 1px solid rgba(220, 53, 69, 0.6);
            color: #5b1119;
        }

        .welcome-text {
            text-align: center;
            font-size: 18px;
            margin-top: 10px;
            color: #1f2d2d;
            font-weight: 600;
        }

        .validation-summary-errors {
            color: #5b1119;
            background: rgba(220, 53, 69, 0.2);
            border: 1px solid rgba(220, 53, 69, 0.6);
            padding: 10px;
            border-radius: 8px;
            margin: 15px auto;
            width: 80%;
        }
    </style>
</head>
<body>

    <div class="page-wrap">
        <h1>Enter Your Appointment Details Below</h1>
        <h3>TELL US ABOUT YOUR APPOINTMENT REQUIREMENTS BELOW.</h3>

        @if (ViewBag.PatientName != null)
        {
            <div class="welcome-text">
                Booking for: @ViewBag.PatientName
            </div>
        }

        @if (TempData["BookingSuccess"] != null)
        {
            <div class="alert-box alert-success">
                @TempData["BookingSuccess"]
            </div>
        }

        @if (TempData["BookingError"] != null)
        {
            <div class="alert-box alert-danger">
                @TempData["BookingError"]
            </div>
        }

        @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

        <form asp-action="CreateAppointment" method="post">
            @Html.AntiForgeryToken()

            <table class="main-layout">
                <tr>
                    <td class="content-area">
                        <table style="width: 100%; border-spacing: 20px 35px;">
                            <tr>
                                <td>
                                    <label><strong>Province:</strong></label><br><br>
                                    <input type="text" name="province" required>
                                </td>
                                <td>
                                    <label><strong>Suburb:</strong></label><br><br>
                                    <input type="text" name="suburb" required>
                                </td>
                            </tr>

                            <tr>
                                <td style="padding-top: 25px;">
                                    <label><strong>Preferred Appointment Date (Optional):</strong></label><br><br>
                                    <input type="date" name="appointmentDate">
                                </td>
                                <td style="padding-top: 25px;">
                                    <label><strong>Preferred healthcare professional:</strong></label><br><br>
                                    <select name="doctorId" required>
                                        <option value="">-- Select a Doctor --</option>

                                        @foreach (var doctor in Model)
                                        {
                                            <option value="@doctor.DoctorId">
                                                @doctor.DoctorName @doctor.DoctorSurname
                                            </option>
                                        }
                                    </select>
                                </td>
                            </tr>

                            <tr>
                                <td colspan="2" style="padding-top: 15px">
                                    <label><strong>Describe your symptoms:</strong></label><br><br>
                                    <textarea rows="9" name="symptoms" required></textarea>
                                </td>
                            </tr>
                        </table>
                    </td>

                    <td class="sidebar">
                        <div class="doctor-box">
                            <button type="button" class="action-btn">Available Doctors</button>

                            <select style="margin-top: 20px; width: 100%; padding: 10px;" disabled>
                                <option value="">-- Select a Doctor --</option>

                                @foreach (var doctor in Model)
                                {
                                    <option value="@doctor.DoctorId">
                                        @doctor.DoctorName @doctor.DoctorSurname
                                    </option>
                                }
                            </select>
                        </div>

                        <div style="margin-top: 60px; text-align: center;">
                            <button type="submit" class="confirm-booking">Confirm Booking Here</button>
                        </div>
                    </td>
                </tr>
            </table>
        </form>
    </div>

</body>
</html>