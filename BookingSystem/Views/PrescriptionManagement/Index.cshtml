<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Medical Care - Prescriptions</title>

    <style>
        body {
            background: linear-gradient(rgba(95, 158, 160, 0.95), rgba(95, 158, 160, 0.95)), url('https://www.transparenttextures.com/patterns/cubes.png') no-repeat center center fixed;
            background-size: cover;
            min-height: 100vh;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }



            .top-table td {
                vertical-align: middle;
            }

        .logo-box {
            font-size: 14px;
            font-weight: bold;
            color: #1f2d2d;
        }

        .small-box {
            width: 140px;
            height: 35px;
            background: rgba(255,255,255,0.65);
            border: 1px solid #cfdede;
            display: inline-block;
        }

   

        .back-btn, .dark-btn, .upload-btn, .confirm-btn, .edit-btn {
            cursor: pointer;
        }

        .page-wrap {
            width: 95%;
            margin: 0 auto;
            padding: 20px 0 40px;
        }

        h1 {
            text-align: center;
            font-family: Georgia, 'Times New Roman', Times, serif;
            font-size: 54px;
            margin: 20px 0 10px;
            color: #2a2a2a;
        }

        h2, h3 {
            text-align: center;
            margin: 8px 0;
            color: #1f2d2d;
        }

        .main-layout {
            width: 100%;
            margin-top: 25px;
        }

        .sidebar {
            width: 200px;
            vertical-align: top;
            padding-right: 20px;
        }

        .content-area {
            vertical-align: top;
        }

        .upload-btn {
            display: inline-block;
            background: #dff5f5;
            border: 1px solid #c8e6e6;
            padding: 12px 24px;
            font-weight: 600;
        }

        .address-box {
            background: rgba(255,255,255,0.4);
            padding: 18px;
            margin-top: 12px;
            min-height: 210px;
            border: 1px solid #c5dddd;
        }

        .confirm-btn {
            margin-top: 30px;
            width: 85px;
            height: 24px;
            background: #365b5b;
            border: none;
        }

        .prescription-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 14px;
        }

            .prescription-table th {
                text-align: left;
                font-size: 16px;
                color: #2b2b2b;
                padding: 0 10px;
            }

            .prescription-table td {
                background: rgba(255,255,255,0.65);
                padding: 12px 10px;
                border: 1px solid #d8ecec;
            }

        input[type="text"], input[type="date"] {
            width: 95%;
            padding: 8px;
            border: 1px solid #c7dede;
            background: transparent;
            outline: none;
        }

        .edit-btn {
            padding: 6px 12px;
            border: 1px solid #8aa;
            background: #e7f6f6;
        }

        .center-icon {
            text-align: center;
            font-size: 32px;
        }

        .back-box, .dark-box {
            width: 45px;
            height: 45px;
            border: none;
            font-size: 22px;
            background: #111;
            color: white;
        }

        .dark-box {
            width: 160px;
            background: #3c5757;
        }
    </style>
</head>
<body>



    <!-- Navigation strip -->
    <div class="page-wrap">
        <div class="nav-bar">
            <table style="width: 100%;">
                <tr>
                    <td style="width: 80px;">
                        <button class="back-box back-btn">&#8592;</button>
                    </td>
                  
                    
                </tr>
            </table>
        </div>

        <h1>Manage Your Prescriptions</h1>

       

        <!-- Main section -->
        <table class="main-layout">
            <tr>
                <!-- Left side -->
                <td class="sidebar">
                    <p><strong>Upload a Clear Image of Your Written Prescription Here:</strong></p>
                    <label class="upload-btn">
                        Upload File Here
                        <input type="file" style="display:none;">
                    </label>

                    <p style="margin-top: 25px;"><strong>Confirm Address Below</strong></p>

                    <div class="address-box">
                        <p>
                            Patients details will populate here and a
                            confirm button below.
                        </p>

                        <textarea rows="6" style="width:100%; border:1px solid #c7dede; background:transparent; resize:none;"></textarea>

                        <button class="confirm-btn">Confirm</button>
                    </div>
                </td>

                <!-- Right side -->
                <td class="content-area">
                    <table class="prescription-table">
                        <thead>
                            <tr>
                                <th>Medicine Name</th>
                                <th>Date of Delivery</th>
                                <th>Name of Doctor</th>
                                <th>Edit Your Prescription</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><input type="text" name="medicine1"></td>
                                <td><input type="date" name="delivery1"></td>
                                <td><input type="text" name="doctor1"></td>
                                <td><button class="edit-btn">Edit</button></td>
                            </tr>
                            <tr>
                                <td><input type="text" name="medicine2"></td>
                                <td><input type="date" name="delivery2"></td>
                                <td><input type="text" name="doctor2"></td>
                                <td><button class="edit-btn">Edit</button></td>
                            </tr>
                            <tr>
                                <td><input type="text" name="medicine3"></td>
                                <td><input type="date" name="delivery3"></td>
                                <td><input type="text" name="doctor3"></td>
                                <td><button class="edit-btn">Edit</button></td>
                            </tr>
                            <tr>
                                <td><input type="text" name="medicine4"></td>
                                <td><input type="date" name="delivery4"></td>
                                <td><input type="text" name="doctor4"></td>
                                <td><button class="edit-btn">Edit</button></td>
                            </tr>
                            <tr>
                                <td><input type="text" name="medicine5"></td>
                                <td><input type="date" name="delivery5"></td>
                                <td><input type="text" name="doctor5"></td>
                                <td><button class="edit-btn">Edit</button></td>
                            </tr>
                            <tr>
                                <td><input type="text" name="medicine6"></td>
                                <td><input type="date" name="delivery6"></td>
                                <td><input type="text" name="doctor6"></td>
                                <td><button class="edit-btn">Edit</button></td>
                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
        </table>
    </div>

</body>
</html>