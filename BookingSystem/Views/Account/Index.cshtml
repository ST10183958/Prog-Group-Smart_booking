@{
    ViewData["Title"] = "Login";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card mt-5">
                <div class="card-header">
                    <h2 class="text-center">Welcome Back to SmartCare</h2>
                </div>
                <div class="card-body">

                    <form asp-action="Login" method="post">
                        @Html.AntiForgeryToken()

                        <!-- Email -->
                        <div class="form-group mb-3">
                            <label for="username" class="form-label">Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                <input type="email" class="form-control" id="username" name="username" required
                                       placeholder="Enter your email address">
                            </div>
                        </div>

                        <!-- Password -->
                        <div class="form-group mb-3">
                            <label for="password" class="form-label">Password</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                <input type="password" class="form-control" id="password" name="password" required
                                       placeholder="Enter your password">
                            </div>
                        </div>

                        <!-- Validation Summary -->
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger">
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            </div>
                        }

                        <!-- Submit -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary-custom">Login</button>
                        </div>
                    </form>

                    <!-- Registration -->
                    <div class="text-center mt-4">
                        <p class="mb-2">Don't have an account?</p>
                        <div class="d-flex justify-content-center gap-2">
                            <a asp-action="Register" class="btn btn-outline-custom btn-sm">Sign up here</a>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<!-- Admin Link -->
<div class="text-center mt-3">
    <a href="./admin" class="text-white-50">Are you an admin? Click here</a>
</div>

<style>
    body {
        background: linear-gradient(rgba(95, 158, 160, 0.95), rgba(95, 158, 160, 0.95)),
        url('https://www.transparenttextures.com/patterns/cubes.png') no-repeat center center fixed;
        background-size: cover;
        min-height: 100vh;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .card {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 20px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
    }

    .card-header {
        background: transparent;
        border-bottom: 1px solid rgba(255, 255, 255, 0.2);
        padding: 20px;
        border-radius: 20px 20px 0 0 !important;
    }

    .card-header h2 {
        color: white;
        font-weight: 300;
        margin: 0;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
    }

    .card-body {
        padding: 30px;
    }

    .form-label {
        color: white;
        font-weight: 500;
        margin-bottom: 8px;
    }

    .input-group-text {
        background: rgba(255, 255, 255, 0.2);
        border: 1px solid rgba(255, 255, 255, 0.3);
        color: white;
        border-radius: 10px 0 0 10px;
    }

    .form-control {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.3);
        color: white;
        padding: 12px;
        border-radius: 0 10px 10px 0;
    }

    .form-control:focus {
        background: rgba(255, 255, 255, 0.15);
        border-color: white;
        box-shadow: 0 0 0 0.2rem rgba(255, 255, 255, 0.25);
        color: white;
    }

    .form-control::placeholder {
        color: rgba(255, 255, 255, 0.6);
    }

    .btn-primary-custom {
        background: white;
        color: cadetblue;
        border: 2px solid white;
        padding: 12px;
        border-radius: 50px;
        font-weight: 600;
        letter-spacing: 0.5px;
        transition: all 0.3s ease;
        text-transform: uppercase;
        font-size: 0.9rem;
    }

    .btn-primary-custom:hover {
        background: transparent;
        color: white;
        transform: scale(1.02);
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
    }

    .btn-outline-custom {
        background: transparent;
        color: white;
        border: 2px solid white;
        border-radius: 50px;
        padding: 8px 20px;
        font-weight: 500;
        transition: all 0.3s ease;
        font-size: 0.85rem;
    }

    .btn-outline-custom:hover {
        background: white;
        color: cadetblue;
        transform: scale(1.02);
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
    }

    .text-white-50 {
        color: rgba(255, 255, 255, 0.7) !important;
        text-decoration: none;
        transition: color 0.3s ease;
    }

    .text-white-50:hover {
        color: white !important;
        text-decoration: underline;
    }

    .alert-danger {
        background: rgba(220, 53, 69, 0.2);
        border: 1px solid rgba(220, 53, 69, 0.5);
        color: white;
        border-radius: 10px;
    }

    p {
        color: white;
    }
</style>