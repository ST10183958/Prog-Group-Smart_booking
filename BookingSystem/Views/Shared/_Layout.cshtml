<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BookingSystemMedical</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BookingSystem.styles.css" asp-append-version="true" />
</head>

<body>
@{
    var userName = Context.Session.GetString("UserName");
    var userRole = Context.Session.GetString("UserRole");
}

<header>
    <nav class="navbar navbar-expand-sm navbar-dark mb-3" style="background-color: darkcyan;">
        <div class="container-fluid">

            <!-- LEFT -->
            <a class="navbar-brand text-white" asp-controller="Home" asp-action="Index">
                <i class="bi bi-house-door"></i> Home
            </a>

            @if (userRole == "Admin")
            {
                <a class="nav-link text-white" asp-controller="Statistics" asp-action="Index">
                    Statistics
                </a>
            }
            else
            {
                <a class="nav-link text-white" asp-controller="AppointmentDetails" asp-action="Index">
                    Booking
                </a>
            }

            @if (userRole == "Patient")
            {
                <a class="nav-link text-white" asp-controller="Prescription" asp-action="Index">
                    Prescriptions
                </a>
            }

            <!-- MOBILE TOGGLER -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- CENTER LOGO -->
            <div class="position-absolute start-50 translate-middle-x">
                <a asp-controller="Home" asp-action="Index">
                    <img src="~/images/MedWebLogo.png" height="60" />
                </a>
            </div>

            <!-- RIGHT SIDE -->
            <div class="collapse navbar-collapse justify-content-end" id="navbarContent">
                <ul class="navbar-nav align-items-center">

                    @if (!string.IsNullOrEmpty(userName))
                    {
                        <li class="nav-item me-3 text-white">
                            Welcome, @userName
                        </li>

                        @if (userRole == "Patient")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Patient" asp-action="Details">
                                    <i class="bi bi-person-circle"></i> My Details
                                </a>
                            </li>
                        }

                        @if (userRole == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="MedicineStock" asp-action="Index">
                                    <i class="bi bi-capsule"></i> Medicine Stock
                                </a>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Account" asp-action="Logout">
                                <i class="bi bi-box-arrow-right"></i> Logout
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Account" asp-action="Index">
                                <i class="bi bi-box-arrow-in-right"></i> Login
                            </a>
                        </li>
                    }

                </ul>
            </div>

        </div>
    </nav>
</header>

<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>