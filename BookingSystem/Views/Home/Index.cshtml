@{
    ViewData["Title"] = "Home Page";
}

<!-- Add Bootstrap Icons in head section of your layout or here -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    body {
        background: linear-gradient(rgba(95, 158, 160, 0.95), rgba(95, 158, 160, 0.95)), url('https://www.transparenttextures.com/patterns/cubes.png') no-repeat center center fixed;
        background-size: cover;
        min-height: 100vh;
        margin: 0;
        padding: 0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .text-center {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        min-height: 70vh;
        margin: 0;
        text-align: center;
        color: white;
        padding: 20px;
    }

    .display-4 {
        color: white;
        font-weight: 300;
        margin-bottom: 20px;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
    }

    .display-6 {
        color: white;
        font-weight: 600;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
        letter-spacing: 1px;
    }

    .feature-card {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 20px;
        padding: 30px 20px;
        height: 100%;
        transition: transform 0.3s ease, background 0.3s ease;
        cursor: default;
        color: white;
    }

        .feature-card:hover {
            transform: translateY(-10px);
            background: rgba(255, 255, 255, 0.2);
            border-color: rgba(255, 255, 255, 0.3);
        }

        .feature-card i {
            font-size: 3.5rem;
            margin-bottom: 20px;
            color: rgba(255, 255, 255, 0.9);
        }

        .feature-card h5 {
            font-size: 1.5rem;
            margin-bottom: 15px;
            font-weight: 600;
        }

        .feature-card p {
            font-size: 1rem;
            opacity: 0.9;
            line-height: 1.6;
        }

    .btn-custom {
        padding: 12px 30px;
        margin: 10px;
        border-radius: 50px;
        font-weight: 600;
        letter-spacing: 0.5px;
        transition: all 0.3s ease;
        text-transform: uppercase;
        font-size: 0.9rem;
    }

    .btn-primary-custom {
        background: white;
        color: cadetblue;
        border: 2px solid white;
    }

        .btn-primary-custom:hover {
            background: transparent;
            color: white;
            transform: scale(1.05);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

    .btn-outline-custom {
        background: transparent;
        color: white;
        border: 2px solid white;
    }

        .btn-outline-custom:hover {
            background: white;
            color: cadetblue;
            transform: scale(1.05);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

    .brief-description {
        max-width: 600px;
        margin: 20px auto;
        color: white;
        line-height: 1.6;
        padding: 0 15px;
        font-size: 1.1rem;
        opacity: 0.9;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .row {
        margin-top: 50px;
    }

    .blockquote {
        margin: 30px 0;
    }

    hr {
        width: 100px;
        height: 3px;
        background: white;
        opacity: 0.5;
        margin: 30px auto;
        border: none;
    }
</style>

<div class="text-center">
    <h1 class="display-4">Welcome to SmartCare</h1>

    <hr>

    <figure class="blockquote">
        <blockquote>
            <p class="display-6">SMART BOOKING FOR BETTER CARE.</p>
        </blockquote>
    </figure>

    <!-- Feature Cards -->
    <div class="container">
        <div class="row g-4">
            <div class="col-md-4">
                <div class="feature-card">
                    <i class="bi bi-calendar-check"></i>
                    <h5>Schedule Appointments</h5>
                    <p>Book appointments with available doctors at your convenience. Choose your preferred time and get instant confirmation.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-card">
                    <i class="bi bi-clock-history"></i>
                    <h5>Real-time Availability</h5>
                    <p>View doctor availability in real-time. See open slots, book instantly, and receive reminders for upcoming visits.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-card">
                    <i class="bi bi-prescription2"></i>
                    <h5>Prescription Management</h5>
                    <p>Access and manage your prescriptions conveniently. View history, request refills, and track your medications online.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Additional Features Section -->
    <div class="container mt-5">
        <div class="row g-4">
            <div class="col-md-3">
                <div class="feature-card" style="padding: 20px;">
                    <i class="bi bi-shield-check" style="font-size: 2rem;"></i>
                    <h6 style="font-size: 1.1rem;">Secure & Private</h6>
                </div>
            </div>
            <div class="col-md-3">
                <div class="feature-card" style="padding: 20px;">
                    <i class="bi bi-phone" style="font-size: 2rem;"></i>
                    <h6 style="font-size: 1.1rem;">Mobile Friendly</h6>
                </div>
            </div>
            <div class="col-md-3">
                <div class="feature-card" style="padding: 20px;">
                    <i class="bi bi-chat-dots" style="font-size: 2rem;"></i>
                    <h6 style="font-size: 1.1rem;">24/7 Support</h6>
                </div>
            </div>
            <div class="col-md-3">
                <div class="feature-card" style="padding: 20px;">
                    <i class="bi bi-star" style="font-size: 2rem;"></i>
                    <h6 style="font-size: 1.1rem;">Top Rated Doctors</h6>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Stats Section -->
    <div class="container mt-5 pt-4">
        <div class="row">
            <div class="col-md-4">
                <h2 class="display-4" style="font-size: 2.5rem;">500+</h2>
                <p>Expert Doctors</p>
            </div>
            <div class="col-md-4">
                <h2 class="display-4" style="font-size: 2.5rem;">50k+</h2>
                <p>Happy Patients</p>
            </div>
            <div class="col-md-4">
                <h2 class="display-4" style="font-size: 2.5rem;">24/7</h2>
                <p>Available Support</p>
            </div>
        </div>
    </div>
</div>

<!-- Optional: Add footer note -->
<div class="text-center text-white mt-5 pb-4" style="opacity: 0.7;">
    <small>© 2026 SmartCare. Your health, our priority.</small>
</div>